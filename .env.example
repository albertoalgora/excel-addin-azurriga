# Turso Database Configuration
# Obtén estos valores desde https://turso.tech/app

# URL de tu base de datos Turso
# Ejemplo: libsql://excel-addin-logs-tu-usuario.turso.io
TURSO_DATABASE_URL=

# Token de autenticación de Turso
# Genéralo desde el dashboard de tu base de datos
TURSO_AUTH_TOKEN=

# Instrucciones:
# 1. Copia este archivo como .env.local
# 2. Ve a https://turso.tech/app
# 3. Selecciona tu base de datos "excel-addin-logs"
# 4. Copia la "Database URL" y pégala arriba
# 5. Click en "Create Token" y pega el token arriba
# 6. Para Vercel: configura estas variables en tu proyecto
#    vercel env add TURSO_DATABASE_URL
#    vercel env add TURSO_AUTH_TOKEN
